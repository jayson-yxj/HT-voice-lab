{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://high-torque.local/schemas/participant-context-v1.json",
  "title": "HT Voice Lab Participant Context",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "created_at",
    "source",
    "policy",
    "participants",
    "observations",
    "evidence",
    "associations",
    "extraction",
    "stats"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["session_memory", "dialogue_state"],
      "properties": {
        "session_memory": {"$ref": "#/$defs/source_file"},
        "dialogue_state": {"$ref": "#/$defs/source_file"}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "identity_scope",
        "auto_create_participants",
        "manual_binding_required",
        "unknown_fields_remain_empty",
        "completed_turns_only"
      ],
      "properties": {
        "identity_scope": {"const": "current_session"},
        "auto_create_participants": {"const": true},
        "manual_binding_required": {"const": false},
        "unknown_fields_remain_empty": {"const": true},
        "completed_turns_only": {"const": true}
      },
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "items": {"$ref": "#/$defs/participant"}
    },
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/observation"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "associations": {
      "type": "array",
      "items": {"$ref": "#/$defs/association"}
    },
    "extraction": {
      "type": "object",
      "required": ["provider", "model", "rejected_claims"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "rejected_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["speaker_label", "claim_index", "reason"],
            "properties": {
              "speaker_label": {"type": "string", "minLength": 1},
              "claim_index": {"type": "integer", "minimum": 0},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "required": ["participants", "completed_turns", "observations", "associations", "rejected_claims"],
      "properties": {
        "participants": {"type": "integer", "minimum": 0},
        "completed_turns": {"type": "integer", "minimum": 0},
        "observations": {"type": "integer", "minimum": 0},
        "associations": {"type": "integer", "minimum": 0},
        "rejected_claims": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "source_file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "participant": {
      "type": "object",
      "required": [
        "participant_id",
        "speaker_label",
        "person_id",
        "display_name",
        "identity_status",
        "observation_ids",
        "evidence_ids"
      ],
      "properties": {
        "participant_id": {"type": "string", "minLength": 1},
        "speaker_label": {"type": "string", "minLength": 1},
        "person_id": {"type": ["string", "null"]},
        "display_name": {"type": ["string", "null"]},
        "identity_status": {"enum": ["anonymous", "session_identified", "persistent_linked"]},
        "observation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "observation_id",
        "participant_id",
        "modality",
        "kind",
        "value",
        "epistemic_status",
        "state",
        "confidence",
        "durability",
        "evidence_ids",
        "evidence_quotes",
        "context_evidence_ids",
        "context_quotes"
      ],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "participant_id": {"type": "string", "minLength": 1},
        "modality": {"enum": ["speech_text", "vision", "multimodal"]},
        "kind": {"enum": ["name", "role", "occupation", "location", "experience", "preference", "goal", "relationship", "communication_style", "trait"]},
        "value": {"type": "string", "minLength": 1},
        "epistemic_status": {"enum": ["explicit", "inferred"]},
        "state": {"enum": ["candidate", "confirmed", "disputed", "superseded"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "durability": {"enum": ["stable", "temporary", "unknown"]},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "evidence_quotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["evidence_id", "quote"],
            "properties": {
              "evidence_id": {"type": "string", "minLength": 1},
              "quote": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "context_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "context_quotes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidence_id", "quote"],
            "properties": {
              "evidence_id": {"type": "string", "minLength": 1},
              "quote": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "participant_id",
        "modality",
        "source_type",
        "source_id",
        "speaker_label",
        "start_s",
        "end_s",
        "content",
        "content_sha256",
        "contribution_ids"
      ],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "participant_id": {"type": "string", "minLength": 1},
        "modality": {"enum": ["speech_text", "vision", "multimodal"]},
        "source_type": {"enum": ["completed_turn", "audio_span", "video_frame", "video_track"]},
        "source_id": {"type": "string", "minLength": 1},
        "speaker_label": {"type": ["string", "null"]},
        "start_s": {"type": ["number", "null"], "minimum": 0},
        "end_s": {"type": ["number", "null"], "minimum": 0},
        "content": {"type": "string"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contribution_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "association": {
      "type": "object",
      "required": ["association_id", "left_ref", "right_ref", "relation", "confidence", "state", "evidence_ids"],
      "properties": {
        "association_id": {"type": "string", "minLength": 1},
        "left_ref": {"type": "string", "minLength": 1},
        "right_ref": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "state": {"enum": ["candidate", "confirmed", "disputed", "superseded"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
