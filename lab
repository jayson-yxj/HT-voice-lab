#!/usr/bin/env bash
set -euo pipefail
LAB_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# Keep ROS Python packages and system CUDA libraries out of the isolated runtime.
unset PYTHONPATH LD_LIBRARY_PATH
export PYTHONNOUSERSITE=1
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-4}"
export HF_HUB_DISABLE_TELEMETRY=1
export TOKENIZERS_PARALLELISM=false
# Published pyannote 3.x checkpoints require Lightning's pre-2.6 load semantics.
# This launcher only loads the official, revision-pinned local checkpoints.
export TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
exec "$LAB_DIR/.venv/bin/python" "$LAB_DIR/scripts/cli.py" "$@"
